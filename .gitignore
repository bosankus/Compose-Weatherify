.gitignore
# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
*/build/

# Kotlin compiler daemon/build cache
.kotlin/
*/.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# AGP release metadata / baseline profiles (never commit build outputs)
app/androidApp/release/
app/wearApp/release/


# Developer-local secrets (RAZORPAY_KEY etc); secrets.defaults.properties is the
# committed placeholder fallback both androidApp (secrets-gradle-plugin) and
# iosApp (app/iosApp/build.gradle.kts) read from.
secrets.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
.idea/artifacts/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json
GoogleService-Info.plist

# SwiftPM import (Kotlin `swiftPMDependencies`): everything under .swiftpm-locks is regenerated
# by Gradle except Package.resolved, which pins the exact Swift package versions and is committed.
.swiftpm-locks/**
!.swiftpm-locks/**/
!.swiftpm-locks/*/swiftImport/Package.resolved

# Legacy CocoaPods leftovers (migration complete — Podfile removed)
Pods/
*.podspec

# XcodeGen (regenerated from project.yml via `xcodegen generate`)
*.xcodeproj/
*.xcworkspace/

# Xcode user-specific state
xcuserdata/
*.xcuserstate

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# MacOS
.DS_Store

# Claude Code local settings/state (machine-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock